import java.util.*;
public class main{
    public static void main(String[] args){
        Scanner sc =  new Scanner(System.in);
        long n = sc.nextLong();
        if(n>=-128 && n<=127) System.out.println("byte");
        else if(n>=-32768 && n<=32767) System.out.println("short");
        else if(n>=-2147483648 && n<=2147483647) System.out.println("int");
        else System.out.println("long"); 
    }
}
