class Solution {
    public String removeOuterParentheses(String s) {
        StringBuilder sb = new StringBuilder();
        int d =0;

        for(char c : s.toCharArray()){
            if(c=='('){
                if(d>0){
                    sb.append(c);
                }
                d++;
            }else{
                d--;
                if(d>0){
                    sb.append(c);
                }
            }
        }
        return sb.toString();
    }
}
