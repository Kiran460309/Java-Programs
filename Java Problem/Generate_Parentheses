class Solution {
    public List<String> generateParenthesis(int n) {
        List<String> result = new ArrayList<>();
        backtrack(result,new StringBuilder(),0,0,n);
        return result;
    }
    private void backtrack(List<String> result,StringBuilder current,int oc ,int clc ,int n){
        if (current.length() == 2 * n) {
            result.add(current.toString());
            return;
        }
        if (oc < n) {
            current.append('(');
            backtrack(result, current, oc + 1, clc, n);
            current.deleteCharAt(current.length() - 1); 
        }
        if (clc < oc) {
            current.append(')');
            backtrack(result, current, oc,clc + 1, n);
            current.deleteCharAt(current.length() - 1); 
        }
    }
}
