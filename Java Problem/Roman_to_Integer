class Solution {
    public int romanToInt(String s) {
        int sum = 0; 
        int pv = getValue(s.charAt(0));

        for(int i = 1 ; i <s.length();i++){
            int cv = getValue(s.charAt(i));
            if(pv<cv){
                sum-=pv;
            }else{
                sum+=pv;
            }
            pv = cv;
        }
        sum+=pv;
        return sum;
    }
    private int getValue(char c){
        switch (c){
            case 'I': return 1;
            case 'V': return 5;
            case 'X': return 10;
            case 'L': return 50;
            case 'C': return 100;
            case 'D': return 500;
            case 'M': return 1000;
            default: return 0;
        }
    }
}
