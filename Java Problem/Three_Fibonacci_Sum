class Solution {
    public boolean threeFibonacciSum(int n) {
        long a1 = 0;
        long a2 =1;
        long a3 =1;

        while(a1+a2+a3 <=n){
            if(a1+a2+a3 ==n){
                return true;
            }
            long nextans = a2+a3;
            a1=a2;
            a2=a3;
            a3=nextans;
        }
        return false;
    }
}©leetcode
