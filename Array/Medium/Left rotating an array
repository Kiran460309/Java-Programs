import java.util.Scanner;
public class arr1{
    static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];
        for (int i=0;i<n;i++){
            arr[i] = sc.nextInt();
        }
        int d =arr[0];
        for(int i = 0 ;i<n-1;i++){
            arr[i] = arr[i+1];
        }
        arr[n-1]=d;
        for(int i=0;i<n;i++){
            System.out.print(arr[i] + " ");
        }
    }
}
