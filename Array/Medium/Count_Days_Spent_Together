class Solution {
    public int countDaysTogether(String arriveAlice, String leaveAlice, String arriveBob, String leaveBob) {
        int aa = dateTODayOfYear(arriveAlice);
        int la = dateTODayOfYear(leaveAlice);
        int ab = dateTODayOfYear(arriveBob);
        int lb = dateTODayOfYear(leaveBob);

        int start = Math.max(aa,ab);
        int over = Math.min(la,lb);

        if(start <=over){
            return over - start+1;
        }
       return 0;
    }
    private int dateTODayOfYear(String date){
        int[] dom={31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};

        int month = Integer.parseInt(date.substring(0,2));
        int day = Integer.parseInt(date.substring(3,5));

        int doy =0;

        for(int i=0;i<month-1;i++){
            doy+=dom[i];
        }
        doy+=day;
        return doy;
    }
}
