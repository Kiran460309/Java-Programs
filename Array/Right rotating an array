import java.util.Scanner;
public class arr2{
    static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];
        for (int i=0;i<n;i++){
            arr[i] = sc.nextInt();// 1 2 3 4 5
        }
        int d =arr[n-1];// 5
        for(int i = n-1 ;i>0;i--)// 4 3 2 1
        {
            arr[i] = arr[i-1];// 4=arr[3]=arr[2]  3=arr[2]=arr[1]  2=arr[1]=arr[0]  1=arr[0]=arr[-1]
        }
        arr[0]=d;// 1=5
        for(int i=0;i<n;i++){// 0 1 2 3 4
            System.out.print(arr[i] + " ");// 5 1 2 3 4
        }
    }
}
