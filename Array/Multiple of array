import java.util.*;
public class Main
{
	public static void main(String[] args) {
	Scanner sc = new Scanner(System.in);
	int size = sc.nextInt();
	int sum =1;
	int[] arr = new int[size];
	for(int i = 0 ; i<size;i++){
	   arr[i] = sc.nextInt();
	}
	for(int i = 0;i<size;i++){
	    sum= arr[i]*sum;
	}
	System.out.print(sum);
	}
}
