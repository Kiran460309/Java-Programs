class Node {
    int data;
    Node next;

    Node(int val) {
        this.data = val;
        this.next = null;
    }
}

class Stack {
    Node top = null;

    void push(int val) {
        Node newnode = new Node(val);
        newnode.next = top;
        top = newnode;
    }

    int pop() {
        if(top == null) return -1;
        int temp = top.data;
        top = top.next;
        return temp;
    }

    int peek() {
        if (top == null) return -1;
        return top.data;
    }

    boolean isEmpty() {
        return top == null;
    }

    void display() {
        Node temp = top;
        while (temp != null) {
            System.out.print(temp.data + " ");
            temp = temp.next;
        }
        System.out.println();
    }
}

public class StackLL {
    public static void main(String[] args) {
        Stack s = new Stack();

        s.push(10);
        s.push(20);
        s.push(30);

        System.out.println(s.peek());
        s.display();

    }
}
