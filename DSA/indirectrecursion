

public class indirectrecursion {
    static void funA(int n) {
        if (n > 0) {
            System.out.println(n);
            funB(n - 1);
        }
    }

    static void funB(int n) {
        if (n > 1) {
            System.out.println(n);
            funA(n / 2);
        }
    }

    public static void main(String[] args) {
        int a = 20;
        funA(a);
    }
}



